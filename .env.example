# Sanity — create a project at https://www.sanity.io/manage
# Copy to `.env` in the repo root (no `export` prefix needed).

VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Also used by `npm run studio` (or set the same values in studio/.env)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
